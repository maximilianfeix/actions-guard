{
  "name": "actions-guard",
  "version": "0.1.0",
  "description": "A GitHub App that reviews pull requests changing GitHub Actions workflows and flags the security risks they introduce.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "actions-guard": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/main.js",
    "check": "npm run format:check && npm run typecheck && npm run coverage && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "images": "node scripts/images.mjs"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks-methods": "^6.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "prettier": "^3.9.9",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "author": "Maximilian Feix",
  "homepage": "https://maximilianfeix.github.io/actions-guard/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximilianfeix/actions-guard.git"
  },
  "bugs": {
    "url": "https://github.com/maximilianfeix/actions-guard/issues",
    "email": "contact@aquaris.dev"
  },
  "keywords": [
    "github-app",
    "github-actions",
    "security",
    "workflow",
    "ci",
    "supply-chain",
    "script-injection",
    "pull-request",
    "linter"
  ]
}
